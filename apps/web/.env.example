# Copy to .env.local and fill from your secrets doc. This file is a COMMITTED
# TEMPLATE — never put real secrets here; secrets go in .env.local (gitignored).
# It is also the canonical env-var reference: each var says which service it
# belongs to and where to obtain it. In production these live in Vercel project
# settings (NEXT_PUBLIC_* vars are build-time — redeploy after changing them).
# The worker's own env is documented in apps/worker/.env.example.

# --- Supabase (Postgres + Auth + pgvector). Project Settings → API: the
#     project URL and the anon + service_role keys. Enable the `vector`
#     extension for knowledge_docs. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Sentry error reporting: sentry.io → Project Settings → Client Keys (DSN).
# Set separately in Vercel Production and Preview scopes. ---
SENTRY_DSN=

# --- Worker: the Cloud Run worker base URL webhooks dispatch turns to
#     (gcloud run services describe ate-worker-prod → status.url; use
#     ate-worker-dev for the development environment) ---
WORKER_URL=http://localhost:8080
# Shared secret for POST /turn (`openssl rand -hex 32`). Required once the
# worker is public (Cloud Run); set the same value on the worker. Leave empty
# for local dev.
WORKER_SHARED_SECRET=

# Public HTTPS origin for vendor OAuth redirects and webhooks. Set this to a
# developer's stable tunnel URL for local E2E; omit it in deployments to use
# the request origin.
PUBLIC_APP_URL=

# --- LLM Provider: Anthropic OR NVIDIA NIM (free tier) ---
# Anthropic: console.anthropic.com → API keys. Used by create step & worker.
ANTHROPIC_API_KEY=
# OR NVIDIA NIM: build.nvidia.com → API keys (nvapi-...).
# If NVIDIA_API_KEY is set, Ate routes LLM turns and drafting through NVIDIA NIM.
NVIDIA_API_KEY=
# Optional NIM overrides:
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# --- Voyage AI: dash.voyageai.com → API keys. Embeds the train pipeline.
#     Anthropic's recommended embeddings partner; knowledge_docs.embedding is
#     vector(1024) to match voyage-3.x — swap provider + dimension together. ---
VOYAGE_API_KEY=

# --- Mem0 recall: app.mem0.ai → API keys. Optional (stubs out without it). ---
MEM0_API_KEY=

# --- Composio app access: app.composio.dev → Settings → API key. Managed
#     OAuth — no per-app credentials needed. ---
COMPOSIO_API_KEY=
# Project webhook signing secret for /api/webhooks/composio (V3).
COMPOSIO_WEBHOOK_SECRET=

# --- AgentMail email channel: agentmail.to → API key. The webhook secret
#     (whsec_…) is returned when creating the org-wide inbound webhook against
#     https://api.agentmail.to/v0/webhooks. ---
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=

# --- Web Search:
#     Option 1: Custom search engine or SearXNG (e.g. Hugging Face Space URL)
SEARCH_ENGINE_URL=
SEARCH_ENGINE_TOKEN=
#     Option 2: Tavily AI Search (1,000 free searches/month)
TAVILY_API_KEY=

# --- Vapi voice channel: vapi.ai dashboard → API Keys (private key =
#     VAPI_API_KEY, public key = NEXT_PUBLIC_VAPI_PUBLIC_KEY, build-time).
#     VAPI_WEBHOOK_SECRET: any random string; sent by Vapi as x-webhook-secret
#     on call events. The per-call system prompt comes from the worker's
#     /context (#119), authenticated with WORKER_SHARED_SECRET like /turn.
#     VAPI_AREA_CODE (optional, defaults 972): the US area code employee phone
#     numbers are bought in (#252). Vapi refuses a create without one. ---
VAPI_API_KEY=
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_AREA_CODE=

# --- Slack. One app per employee, created at hire.
# The App Configuration Token is NOT an env var: it expires every 12h and
# rotates, so it lives in the singleton `slack_config_token` table and refreshes
# itself (#48, supabase/migrations/0005_slack_config_token.sql). Seed each
# environment from its own refresh token, generated by a different Slack user
# with app-management permission — a pair is per (user, workspace), so two
# environments sharing one both rotate the same chain and the second breaks
# (#235).
# Each employee's signing secret and bot token are stored on its own row at
# hire/install time — there are no global Slack credentials (#71).
