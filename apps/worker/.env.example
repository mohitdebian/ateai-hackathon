# Worker runtime env. In production these are set ONCE on the Cloud Run service
# (gcloud run services update ate-worker-prod|-dev --update-env-vars ...) and survive
# CI deploys — no secret lives in the repo or CI. Locally: copy to .env and run
# with your process manager of choice. This file is a COMMITTED TEMPLATE.

# LLM Provider: Anthropic OR NVIDIA NIM (free tier).
# Anthropic — console.anthropic.com → API keys.
ANTHROPIC_API_KEY=
# OR NVIDIA NIM — build.nvidia.com → API keys (nvapi-...).
# If NVIDIA_API_KEY is present, Ate routes turns and tool-calling to NVIDIA NIM.
NVIDIA_API_KEY=
# Optional NIM overrides:
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Supabase — project Settings → API. Service role: the worker bypasses RLS and
# scopes queries explicitly. Required: without these the worker boots (health
# check answers) but every turn fails.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Sentry error reporting: sentry.io → Project Settings → Client Keys (DSN).
# Set SENTRY_ENVIRONMENT to production or development on each Cloud Run service.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Shared secret gating POST /turn, /heartbeat, and /context (x-worker-secret
# header) — the Cloud Run URL is public, this is the auth. Generate with
# `openssl rand -hex 32`; set the SAME value as WORKER_SHARED_SECRET on
# Vercel. Leave empty for local dev.
WORKER_SHARED_SECRET=

# Voyage AI — dash.voyageai.com. Embeds knowledge queries (vector 1024,
# matches knowledge_docs.embedding). Optional: retrieval stubs out without it.
VOYAGE_API_KEY=

# Cosine floor a knowledge chunk must clear to enter the prompt (#104).
# Default 0.3. Tune from the worker's `[knowledge] N chunk(s)` log line.
# KNOWLEDGE_MIN_SCORE=

# Mem0 — app.mem0.ai → API keys. Long-term recall memory. Optional: stubs out.
MEM0_API_KEY=

# Composio — app.composio.dev → Settings → API key. Lets turns use the apps
# granted to an employee. Optional: turns degrade to plain conversation.
COMPOSIO_API_KEY=

# AgentMail — agentmail.to → API key. The worker sends email replies from the
# employee's inbox. Optional until the email channel is live.
AGENTMAIL_API_KEY=

# Web search options:
# Option 1: Custom search engine or SearXNG (e.g. Hugging Face Space URL)
SEARCH_ENGINE_URL=
# Optional auth token for private search spaces
SEARCH_ENGINE_TOKEN=
# Option 2: Tavily AI Search (1,000 free searches/month)
TAVILY_API_KEY=

# Optional override of the heartbeat follow-up prompt (default in
# src/heartbeat.ts).
# HEARTBEAT_PROMPT=
