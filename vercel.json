{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "name": "ate-ai",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "worker",
          "format": "url",
          "env": "WORKER_URL"
        }
      ]
    },
    "worker": {
      "root": "apps/worker",
      "runtime": "container"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
